# Copy to .env on the server and fill in the values (never commit .env)

SECRET_KEY=
DEBUG=False

# localhost and 127.0.0.1 are needed for the container health check
ALLOWED_HOSTS=aurora-api.devrimdev.no,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://aurora-api.devrimdev.no
CORS_ALLOWED_ORIGINS=https://aurora-trails.onrender.com

# Aiven PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=require

# Backblaze B2 (media files)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
